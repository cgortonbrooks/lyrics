---
import Layout from '../layouts/Layout.astro';
import { getPlayPath, getSongs, groupSongsByArtist } from '../lib/songs';

const songs = await getSongs();
const artistGroups = groupSongsByArtist(songs);
---

<Layout title="Lyrics Workbench" description="Browse songs by title or artist and open a minimal play view.">
	<main class="shell">
		<section class="hero panel">
			<label class="search" for="song-search">
				<input id="song-search" type="search" placeholder="Search title or artist" autocomplete="off" data-song-search />
			</label>
			<div class="hero__meta">
				<div class="metric">
					<strong>{songs.length}</strong>
					<span>Songs</span>
				</div>
				<div class="metric">
					<strong>{artistGroups.length}</strong>
					<span>Artists</span>
				</div>
			</div>
		</section>

		<section class="song-grid" aria-label="Song browser">
			<details class="song-list panel" open>
				<summary class="section-heading">
					<h2>Songs</h2>
					<span class="section-copy">Search filters this list instantly in the browser.</span>
				</summary>
				<ul class="cards" data-song-list>
					{
						songs.map((song) => (
							<li
								class="song-card"
								data-song-card
								data-filter={`${song.data.title} ${song.data.artist}`.toLowerCase()}
							>
								<div>
									<p class="song-card__artist">{song.data.artist}</p>
									<h3>{song.data.title}</h3>
									<p class="song-card__meta">
										{song.data.bpm} BPM · Capo {song.data.capo} · {song.data.chords.join(' · ')}
									</p>
								</div>
								<div class="song-card__actions">
									<a class="pill button--accent" href={getPlayPath(song)}>Play</a>
								</div>
							</li>
						))
					}
				</ul>
			</details>

			<details class="artist-list panel" open>
				<summary class="section-heading">
					<h2>Artists</h2>
					<span class="section-copy">Jump straight into play mode from each artist grouping.</span>
				</summary>
				<div class="artist-groups">
					{
						artistGroups.map((group) => (
							<section class="artist-group" data-artist-group>
								<div class="artist-group__header">
									<h3>{group.artist}</h3>
									<span>{group.songs.length} song{group.songs.length === 1 ? '' : 's'}</span>
								</div>
								<ul>
									{group.songs.map((song) => (
										<li data-filter={song.data.title.toLowerCase()}>
											<a href={getPlayPath(song)}>{song.data.title}</a>
										</li>
									))}
								</ul>
							</section>
						))
					}
				</div>
			</details>
		</section>

	</main>

	<script>
		const searchInput = document.querySelector('[data-song-search]');
		const cards = [...document.querySelectorAll('[data-song-card]')];
		const artistGroups = [...document.querySelectorAll('[data-artist-group]')];

		searchInput?.addEventListener('input', (event) => {
			const query = event.currentTarget instanceof HTMLInputElement ? event.currentTarget.value.trim().toLowerCase() : '';

			cards.forEach((card) => {
				const matches = !query || card.dataset.filter?.includes(query);
				card.toggleAttribute('hidden', !matches);
			});

			artistGroups.forEach((group) => {
				const matches = !query || [...group.querySelectorAll('[data-filter]')].some((item) => item.dataset.filter?.includes(query));
				group.toggleAttribute('hidden', !matches);
			});
		});
	</script>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.5rem;
		padding: 1.5rem;
		margin-bottom: 1.5rem;
		align-items: end;
	}

	h2,
	h3,
	p {
		margin: 0;
	}

	.search {
		display: block;
		margin: 0;
	}

	.search input {
		width: 100%;
		padding: 0.9rem 1rem;
		border-radius: 16px;
		border: 1px solid var(--line);
		background: rgba(12, 17, 22, 0.92);
		color: var(--ink);
	}

	.search input::placeholder {
		color: var(--muted);
	}

	.hero__meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.metric {
		padding: 1rem;
		border-radius: 20px;
		background: var(--surface-strong);
		border: 1px solid var(--line);
	}

	.metric strong {
		display: block;
		font-size: 2rem;
	}

	.metric span,
	.section-copy,
	.song-card__artist,
	.song-card__meta,
	.artist-group span {
		color: var(--muted);
	}

	.song-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 1.5rem;
	}

	.song-list,
	.artist-list {
		padding: 1.5rem;
	}

	.section-heading,
	.artist-group__header,
	.song-card {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 1rem;
	}

	.section-heading {
		cursor: pointer;
		list-style: none;
	}

	.section-heading::-webkit-details-marker {
		display: none;
	}

	.section-heading::after {
		content: '+';
		font-size: 1.35rem;
		line-height: 1;
		color: var(--muted);
	}

	details[open] > .section-heading::after {
		content: '\2212';
	}

	.cards,
	.artist-groups,
	.artist-group ul {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
	}

	.cards,
	.artist-groups {
		display: grid;
		gap: 0.9rem;
	}

	.song-card,
	.artist-group {
		padding: 1rem;
		border-radius: 20px;
		background: var(--surface-strong);
		border: 1px solid var(--line);
	}

	.song-card h3,
	.artist-group h3 {
		font-size: 1.15rem;
	}

	.song-card__actions {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.artist-group ul {
		display: grid;
		gap: 0.35rem;
		margin-top: 0.75rem;
	}

	.artist-group li a {
		text-decoration: underline;
		text-decoration-color: rgba(182, 90, 42, 0.3);
		text-underline-offset: 0.18rem;
	}

	[hidden] {
		display: none !important;
	}

	@media (max-width: 900px) {
		.hero,
		.song-grid {
			grid-template-columns: 1fr;
		}

		.hero__meta {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.hero,
		.song-list,
		.artist-list {
			padding: 1rem;
		}

		.song-card,
		.artist-group,
		.section-heading,
		.artist-group__header {
			flex-direction: column;
		}
	}
</style>
