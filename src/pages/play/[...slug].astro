---
import Layout from '../../layouts/Layout.astro';
import { getSongLines, getSongs, withBase } from '../../lib/songs';

export async function getStaticPaths() {
	const songs = await getSongs();

	return songs.map((song) => ({
		params: { slug: song.id },
		props: { song },
	}));
}

const { song } = Astro.props;
const lines = getSongLines(song);
const songInfoItems = [
	{ label: 'Key', value: song.data.key },
	{ label: 'Capo', value: String(song.data.capo ?? 'None') },
	{ label: 'Tuning', value: song.data.tuning },
	{ label: 'BPM', value: String(song.data.bpm) },
	{ label: 'Duration', value: song.data.duration },
	{ label: 'Notes', value: song.data.notes },
].filter((item) => typeof item.value === 'string' && item.value.trim().length > 0);

function parseDurationToSeconds(duration: string) {
	const [minutesText, secondsText] = duration.split(':');
	const minutes = Number(minutesText);
	const seconds = Number(secondsText);

	if (!Number.isFinite(minutes) || !Number.isFinite(seconds)) {
		return 0;
	}

	return minutes * 60 + seconds;
}

const durationSeconds = parseDurationToSeconds(song.data.duration);
---

<Layout title={`${song.data.title} · Play`} description={`Play view for ${song.data.title}`} bodyClass="play-body">
	<main class="play-shell">
		<section class="play-surface" data-play-surface>
			<ol class="play-lyrics lyrics-font" data-play-lyrics>
				{
					lines.map((line, index) => (
						<li class:list={['play-line', { spacer: line.trim().length === 0 }]} data-line data-index={index}>
							{line || ' '}
						</li>
					))
				}
			</ol>
		</section>

		<footer class="play-controls panel" data-controls data-bpm={song.data.bpm} data-duration-seconds={durationSeconds}>
			<div class="transport-row">
				<a class="icon-button" href={withBase('')} aria-label="Library" title="Library">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M3 10.5 12 3l9 7.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
						<path d="M5.25 9.75V21h13.5V9.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
						<path d="M9.75 21v-6h4.5v6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
					</svg>
					<span class="visually-hidden">Library</span>
				</a>
				<button class="icon-button icon-button--accent" type="button" data-toggle-scroll aria-label="Start scroll" title="Start scroll">
					<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M8 6.5v11l9-5.5-9-5.5Z" fill="currentColor"></path>
					</svg>
					<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M8 6.5h3.5v11H8zm4.5 0H16v11h-3.5z" fill="currentColor"></path>
					</svg>
					<span class="visually-hidden" data-toggle-label>Start scroll</span>
				</button>
				<button class="icon-button" type="button" data-toggle-metronome aria-pressed="false" aria-label="Start metronome" title="Start metronome">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 3 6.75 20.25h10.5L12 3Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"></path>
						<path d="M12 7.5v5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
						<path d="m10 12 4-2.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
						<path d="M9 20.25h6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
					</svg>
					<span class="visually-hidden" data-metronome-label>Start metronome</span>
				</button>
				<button class="icon-button" type="button" data-toggle-metronome-sound aria-pressed="false" aria-label="Enable tic toc" title="Enable tic toc">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M5.5 14.5a3 3 0 0 0 0-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
						<path d="M8.75 17.25a6.5 6.5 0 0 0 0-10.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
						<path d="M12 19.5a9 9 0 0 0 0-15" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
						<path d="M4 10.5h2.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
					</svg>
					<span class="visually-hidden" data-metronome-sound-label>Enable tic toc</span>
				</button>
				<button class="icon-button" type="button" data-toggle-info aria-expanded="false" aria-controls="song-info-modal" aria-label="Show song info" title="Show song info">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
						<path d="M12 10.25v5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
						<circle cx="12" cy="7.5" r="1" fill="currentColor"></circle>
					</svg>
					<span class="visually-hidden">Show song info</span>
				</button>
			</div>
			<label class="speed-control">
				<input type="range" min="0" max="100" value="50" step="1" data-speed aria-label="Scroll speed" />
			</label>
		</footer>

		<div class="info-modal" data-info-modal hidden>
			<div class="info-modal__backdrop" data-info-close></div>
			<section class="info-modal__panel panel" id="song-info-modal" role="dialog" aria-modal="true" aria-labelledby="song-info-title">
				<header class="info-modal__header">
					<div>
						<p class="info-modal__eyebrow">Song Info</p>
						<h2 class="info-modal__title" id="song-info-title">{song.data.title}</h2>
						<p class="info-modal__subtitle">{song.data.artist}</p>
					</div>
					<button class="icon-button info-modal__close" type="button" data-info-close aria-label="Close song info" title="Close song info">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M7 7 17 17" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
							<path d="M17 7 7 17" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
						</svg>
					</button>
				</header>

				<div class="info-modal__body">
					<dl class="info-grid">
						{
							songInfoItems.map((item) => (
								<div class="info-grid__item">
									<dt>{item.label}</dt>
									<dd>{item.value}</dd>
								</div>
							))
						}
					</dl>

					{
						song.data.chords.length > 0 && (
							<section class="info-section">
								<h3>Chords</h3>
								<ul class="chord-list" aria-label="Song chords">
									{song.data.chords.map((chord) => <li>{chord}</li>)}
								</ul>
							</section>
						)
					}
				</div>
			</section>
		</div>
	</main>

	<script>
		const surface = document.querySelector('[data-play-surface]');
		const lyrics = document.querySelector('[data-play-lyrics]');
		const controls = document.querySelector('[data-controls]');
		const speedInput = document.querySelector('[data-speed]');
		const toggleButton = document.querySelector('[data-toggle-scroll]');
		const toggleLabel = document.querySelector('[data-toggle-label]');
		const metronomeButton = document.querySelector('[data-toggle-metronome]');
		const metronomeLabel = document.querySelector('[data-metronome-label]');
		const metronomeSoundButton = document.querySelector('[data-toggle-metronome-sound]');
		const metronomeSoundLabel = document.querySelector('[data-metronome-sound-label]');
		const infoButton = document.querySelector('[data-toggle-info]');
		const infoModal = document.querySelector('[data-info-modal]');
		const infoCloseButtons = [...document.querySelectorAll('[data-info-close]')];
		const lines = [...document.querySelectorAll('[data-line]')];
		const lineElements = lines.filter((line) => line instanceof HTMLElement);

		const getSpeedMultiplierFromSlider = (value) => {
			if (!Number.isFinite(value)) {
				return 1;
			}

			if (value <= 50) {
				return 0.5 + (value / 50) * 0.5;
			}

			return 1 + ((value - 50) / 50) * 1;
		};

		let isRunning = false;
		let metronomeRunning = false;
		let speedMultiplier = speedInput instanceof HTMLInputElement ? getSpeedMultiplierFromSlider(Number(speedInput.value)) : 1;
		let bpm = controls instanceof HTMLElement ? Number(controls.dataset.bpm ?? '0') : 0;
		let durationSeconds = controls instanceof HTMLElement ? Number(controls.dataset.durationSeconds ?? '0') : 0;
		let hasInitializedPosition = false;
		let metronomeTimer = 0;
		let metronomeIsLight = false;
		let metronomeBeatIndex = 0;
		let metronomeSoundEnabled = false;
		let metronomeAudioContext = null;
		let metronomeNoiseBuffer = null;
		let wakeLockSentinel = null;
		let playbackAnimation = null;
		let currentOffset = 0;
		let startOffset = 0;
		let endOffset = 0;
		let lineOffsets = [];
		let dragPointerId = null;
		let dragStartY = 0;
		let dragStartOffset = 0;
		let resumeAfterDrag = false;
		let infoWasOpen = false;

		const getDurationMs = () => Math.max(1000, durationSeconds * 1000);
		const canUseWakeLock = typeof navigator !== 'undefined' && 'wakeLock' in navigator;

		const releaseScreenWakeLock = async () => {
			if (!wakeLockSentinel) {
				return;
			}

			const activeSentinel = wakeLockSentinel;
			wakeLockSentinel = null;

			try {
				await activeSentinel.release();
			} catch {
				// Ignore release failures; the sentinel is no longer usable either way.
			}
		};

		const requestScreenWakeLock = async () => {
			if (!canUseWakeLock || wakeLockSentinel || document.visibilityState !== 'visible') {
				return;
			}

			try {
				wakeLockSentinel = await navigator.wakeLock.request('screen');
				wakeLockSentinel.addEventListener('release', () => {
					wakeLockSentinel = null;
				});
			} catch {
				wakeLockSentinel = null;
			}
		};

		const syncScreenWakeLock = () => {
			if (document.visibilityState === 'visible') {
				void requestScreenWakeLock();
				return;
			}

			void releaseScreenWakeLock();
		};

		const isInfoModalOpen = () => infoModal instanceof HTMLElement && !infoModal.hasAttribute('hidden');

		const openInfoModal = () => {
			if (!(infoModal instanceof HTMLElement)) {
				return;
			}

			infoModal.removeAttribute('hidden');
			infoModal.classList.add('is-open');
			infoButton?.classList.add('is-active');
			infoButton?.setAttribute('aria-expanded', 'true');
		};

		const closeInfoModal = () => {
			if (!(infoModal instanceof HTMLElement)) {
				return;
			}

			infoModal.setAttribute('hidden', '');
			infoModal.classList.remove('is-open');
			infoButton?.classList.remove('is-active');
			infoButton?.setAttribute('aria-expanded', 'false');
		};

		const clampOffset = (value) => {
			if (!Number.isFinite(value)) {
				return 0;
			}

			if (startOffset >= endOffset) {
				return Math.max(endOffset, Math.min(startOffset, value));
			}

			return Math.max(startOffset, Math.min(endOffset, value));
		};

		const applyOffset = (offset) => {
			if (!(lyrics instanceof HTMLElement)) {
				return;
			}

			currentOffset = clampOffset(offset);
			lyrics.style.transform = `translate3d(0, ${currentOffset.toFixed(2)}px, 0)`;
		};

		const getOffsetForLine = (line, index) => {
			if (!(surface instanceof HTMLElement)) {
				return 0;
			}

			const anchorRatio = index === 0 ? 0.38 : 0.32;
			return surface.clientHeight * anchorRatio - line.offsetTop;
		};

		const getProgressFromOffset = (offset = currentOffset) => {
			const totalDistance = startOffset - endOffset;
			if (Math.abs(totalDistance) < 0.5) {
				return 0;
			}

			return Math.max(0, Math.min(1, (startOffset - offset) / totalDistance));
		};

		const getOffsetFromProgress = (progress) => {
			const clampedProgress = Math.max(0, Math.min(1, progress));
			return startOffset + (endOffset - startOffset) * clampedProgress;
		};

		const getNearestLineIndex = () => {
			if (lineOffsets.length === 0) {
				return 0;
			}

			let closestIndex = 0;
			let closestDistance = Number.POSITIVE_INFINITY;

			lineOffsets.forEach((offset, index) => {
				const distance = Math.abs(offset - currentOffset);
				if (distance < closestDistance) {
					closestDistance = distance;
					closestIndex = index;
				}
			});

			return closestIndex;
		};

		const buildPlaybackMetrics = () => {
			if (!(surface instanceof HTMLElement) || lineElements.length === 0) {
				lineOffsets = [];
				startOffset = 0;
				endOffset = 0;
				return;
			}

			lineOffsets = lineElements.map((line, index) => getOffsetForLine(line, index));
			startOffset = lineOffsets[0] ?? 0;
			endOffset = lineOffsets[lineOffsets.length - 1] ?? startOffset;

			if (startOffset < endOffset) {
				const swap = startOffset;
				startOffset = endOffset;
				endOffset = swap;
				lineOffsets = lineOffsets.map((offset) => Math.max(endOffset, Math.min(startOffset, offset)));
			}
		};

		const stopPlaybackEngine = () => {
			if (playbackAnimation) {
				const currentTime = Number(playbackAnimation.currentTime ?? 0);
				const progress = Math.max(0, Math.min(1, currentTime / getDurationMs()));
				playbackAnimation.cancel();
				playbackAnimation = null;
				applyOffset(getOffsetFromProgress(progress));
			}
		};

		const startPlaybackEngine = () => {
			if (!(lyrics instanceof HTMLElement)) {
				return;
			}

			stopPlaybackEngine();

			const durationMs = getDurationMs();
			const initialProgress = getProgressFromOffset();
			if (initialProgress >= 1) {
				applyOffset(startOffset);
			}

			playbackAnimation = lyrics.animate(
				[
					{ transform: `translate3d(0, ${startOffset}px, 0)` },
					{ transform: `translate3d(0, ${endOffset}px, 0)` },
				],
				{
					duration: durationMs,
					fill: 'both',
					easing: 'linear',
				},
			);

			playbackAnimation.pause();
			playbackAnimation.currentTime = getProgressFromOffset() * durationMs;
			playbackAnimation.playbackRate = speedMultiplier;
			playbackAnimation.onfinish = () => {
				applyOffset(endOffset);
				stopScrollPlayback();
			};
			playbackAnimation.play();
		};

		const setInitialPosition = () => {
			if (!(surface instanceof HTMLElement) || lineElements.length === 0) {
				return;
			}

			buildPlaybackMetrics();
			if (lineOffsets.length === 0) {
				return;
			}

			if (!hasInitializedPosition) {
				applyOffset(startOffset);
				hasInitializedPosition = true;
				return;
			}

			const targetIndex = getNearestLineIndex();
			applyOffset(lineOffsets[targetIndex] ?? startOffset);
		};

		const stopScrollPlayback = () => {
			isRunning = false;
			stopPlaybackEngine();
			toggleButton?.classList.remove('is-active');
			toggleButton?.setAttribute('aria-label', 'Start scroll');
			toggleButton?.setAttribute('title', 'Start scroll');
			if (toggleLabel instanceof HTMLElement) {
				toggleLabel.textContent = 'Start scroll';
			}
		};

		const startScrollPlayback = () => {
			if (!(surface instanceof HTMLElement) || !(lyrics instanceof HTMLElement) || isRunning) {
				return;
			}

			buildPlaybackMetrics();
			if (lineOffsets.length === 0) {
				return;
			}

			if (getProgressFromOffset() >= 1) {
				applyOffset(startOffset);
			}

			isRunning = true;
			toggleButton?.classList.add('is-active');
			toggleButton?.setAttribute('aria-label', 'Pause scroll');
			toggleButton?.setAttribute('title', 'Pause scroll');
			if (toggleLabel instanceof HTMLElement) {
				toggleLabel.textContent = 'Pause scroll';
			}

			startPlaybackEngine();
		};

		const beginDrag = (clientY, pointerId = null) => {
			if (!(surface instanceof HTMLElement)) {
				return;
			}

			infoWasOpen = isInfoModalOpen();
			if (infoWasOpen) {
				closeInfoModal();
			}
			resumeAfterDrag = isRunning;
			stopScrollPlayback();
			dragPointerId = pointerId;
			dragStartY = clientY;
			dragStartOffset = currentOffset;
			surface.classList.add('is-dragging');
		};

		const updateDrag = (clientY) => {
			if (dragPointerId === null && clientY === 0) {
				return;
			}

			applyOffset(dragStartOffset + (clientY - dragStartY));
		};

		const endDrag = (pointerId = null) => {
			if (pointerId !== null && dragPointerId !== pointerId) {
				return;
			}

			const shouldResumePlayback = resumeAfterDrag;
			resumeAfterDrag = false;
			dragPointerId = null;
			if (surface instanceof HTMLElement) {
				surface.classList.remove('is-dragging');
			}

			if (shouldResumePlayback) {
				startScrollPlayback();
			}

			if (infoWasOpen) {
				openInfoModal();
				infoWasOpen = false;
			}
		};

		const clearMetronomePulse = () => {
			metronomeIsLight = false;
			controls?.classList.remove('is-metronome-active');
			controls?.classList.remove('is-beating');
		};

		const updateMetronomeSoundButton = () => {
			metronomeSoundButton?.classList.toggle('is-active', metronomeSoundEnabled);
			metronomeSoundButton?.setAttribute('aria-pressed', String(metronomeSoundEnabled));
			metronomeSoundButton?.setAttribute('aria-label', metronomeSoundEnabled ? 'Disable tic toc' : 'Enable tic toc');
			metronomeSoundButton?.setAttribute('title', metronomeSoundEnabled ? 'Disable tic toc' : 'Enable tic toc');

			if (metronomeSoundLabel instanceof HTMLElement) {
				metronomeSoundLabel.textContent = metronomeSoundEnabled ? 'Disable tic toc' : 'Enable tic toc';
			}
		};

		const getMetronomeAudioContext = () => {
			const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
			if (!AudioContextCtor) {
				return null;
			}

			if (!metronomeAudioContext) {
				metronomeAudioContext = new AudioContextCtor();
			}

			return metronomeAudioContext;
		};

		const getMetronomeNoiseBuffer = (audioContext) => {
			if (metronomeNoiseBuffer && metronomeNoiseBuffer.sampleRate === audioContext.sampleRate) {
				return metronomeNoiseBuffer;
			}

			const frameCount = Math.max(1, Math.floor(audioContext.sampleRate * 0.03));
			const buffer = audioContext.createBuffer(1, frameCount, audioContext.sampleRate);
			const channelData = buffer.getChannelData(0);

			for (let index = 0; index < frameCount; index += 1) {
				channelData[index] = Math.random() * 2 - 1;
			}

			metronomeNoiseBuffer = buffer;
			return metronomeNoiseBuffer;
		};

		const resumeMetronomeAudioContext = async () => {
			const audioContext = getMetronomeAudioContext();
			if (!audioContext) {
				return false;
			}

			if (audioContext.state === 'suspended') {
				await audioContext.resume();
			}

			return audioContext.state === 'running';
		};

		const playMetronomeSound = () => {
			if (!metronomeSoundEnabled) {
				metronomeBeatIndex += 1;
				return;
			}

			const audioContext = getMetronomeAudioContext();
			if (!audioContext || audioContext.state !== 'running') {
				metronomeBeatIndex += 1;
				return;
			}

			const isTic = metronomeBeatIndex % 2 === 0;
			const oscillator = audioContext.createOscillator();
			const gainNode = audioContext.createGain();
			const filterNode = audioContext.createBiquadFilter();
			const noiseSource = audioContext.createBufferSource();
			const noiseFilterNode = audioContext.createBiquadFilter();
			const noiseGainNode = audioContext.createGain();
			const startTime = audioContext.currentTime;
			const attack = 0.0015;
			const release = isTic ? 0.095 : 0.13;
			const noiseRelease = isTic ? 0.026 : 0.032;

			oscillator.type = isTic ? 'triangle' : 'sine';
			oscillator.frequency.setValueAtTime(isTic ? 780 : 620, startTime);
			filterNode.type = 'lowpass';
			filterNode.frequency.setValueAtTime(isTic ? 1100 : 900, startTime);
			filterNode.Q.value = 0.4;
			gainNode.gain.setValueAtTime(0.0001, startTime);
			gainNode.gain.linearRampToValueAtTime(isTic ? 0.07 : 0.055, startTime + attack);
			gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + release);

			noiseSource.buffer = getMetronomeNoiseBuffer(audioContext);
			noiseFilterNode.type = 'bandpass';
			noiseFilterNode.frequency.setValueAtTime(isTic ? 2100 : 1700, startTime);
			noiseFilterNode.Q.value = isTic ? 1.2 : 0.9;
			noiseGainNode.gain.setValueAtTime(0.0001, startTime);
			noiseGainNode.gain.linearRampToValueAtTime(isTic ? 0.02 : 0.016, startTime + 0.0008);
			noiseGainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + noiseRelease);

			oscillator.connect(filterNode);
			filterNode.connect(gainNode);
			gainNode.connect(audioContext.destination);
			noiseSource.connect(noiseFilterNode);
			noiseFilterNode.connect(noiseGainNode);
			noiseGainNode.connect(audioContext.destination);
			oscillator.start(startTime);
			oscillator.stop(startTime + release + 0.02);
			noiseSource.start(startTime);
			noiseSource.stop(startTime + noiseRelease + 0.01);

			metronomeBeatIndex += 1;
		};

		const pulseMetronome = () => {
			if (!(controls instanceof HTMLElement)) {
				return;
			}

			controls.classList.add('is-metronome-active');
			metronomeIsLight = !metronomeIsLight;
			controls.classList.toggle('is-beating', metronomeIsLight);
			playMetronomeSound();
		};

		const stopMetronome = () => {
			metronomeRunning = false;
			if (metronomeTimer) {
				window.clearInterval(metronomeTimer);
				metronomeTimer = 0;
			}
			clearMetronomePulse();
			metronomeButton?.setAttribute('aria-pressed', 'false');
			metronomeButton?.classList.remove('is-active');
			metronomeButton?.setAttribute('aria-label', 'Start metronome');
			metronomeButton?.setAttribute('title', 'Start metronome');
			if (metronomeLabel instanceof HTMLElement) {
				metronomeLabel.textContent = 'Start metronome';
			}
			metronomeBeatIndex = 0;
		};

		const startMetronome = async () => {
			if (!Number.isFinite(bpm) || bpm <= 0) {
				return;
			}

			if (metronomeSoundEnabled) {
				await resumeMetronomeAudioContext();
			}

			stopMetronome();
			metronomeRunning = true;
			metronomeButton?.setAttribute('aria-pressed', 'true');
			metronomeButton?.classList.add('is-active');
			metronomeButton?.setAttribute('aria-label', 'Stop metronome');
			metronomeButton?.setAttribute('title', 'Stop metronome');
			if (metronomeLabel instanceof HTMLElement) {
				metronomeLabel.textContent = 'Stop metronome';
			}

			metronomeIsLight = false;
			metronomeBeatIndex = 0;
			pulseMetronome();
			metronomeTimer = window.setInterval(pulseMetronome, 60000 / bpm);
		};

		speedInput?.addEventListener('input', (event) => {
			if (event.currentTarget instanceof HTMLInputElement) {
				speedMultiplier = getSpeedMultiplierFromSlider(Number(event.currentTarget.value));
				if (playbackAnimation) {
					playbackAnimation.playbackRate = speedMultiplier;
				}
			}
		});

		toggleButton?.addEventListener('click', () => {
			if (isRunning) {
				stopScrollPlayback();
				return;
			}

			startScrollPlayback();
		});

		metronomeButton?.addEventListener('click', () => {
			if (metronomeRunning) {
				stopMetronome();
			} else {
				startMetronome();
			}
		});

		metronomeSoundButton?.addEventListener('click', async () => {
			metronomeSoundEnabled = !metronomeSoundEnabled;
			updateMetronomeSoundButton();

			if (metronomeSoundEnabled) {
				await resumeMetronomeAudioContext();
			}
		});

		infoButton?.addEventListener('click', () => {
			if (isInfoModalOpen()) {
				closeInfoModal();
				return;
			}

			openInfoModal();
		});

		infoCloseButtons.forEach((button) => {
			button.addEventListener('click', () => {
				closeInfoModal();
			});
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isInfoModalOpen()) {
				closeInfoModal();
			}
		});

		lineElements.forEach((line, index) => {
			line.addEventListener('click', () => {
				if (!(surface instanceof HTMLElement)) {
					return;
				}

				const resumePlayback = isRunning;
				stopScrollPlayback();
				applyOffset(lineOffsets[index] ?? currentOffset);

				if (resumePlayback) {
					startScrollPlayback();
				}
			});
		});

		surface?.addEventListener('pointerdown', (event) => {
			if (!(event instanceof PointerEvent) || !event.isPrimary) {
				return;
			}

			if (event.pointerType === 'mouse' && event.button !== 0) {
				return;
			}

			beginDrag(event.clientY, event.pointerId);
			surface.setPointerCapture?.(event.pointerId);
		}, { passive: true });

		surface?.addEventListener('pointermove', (event) => {
			if (!(event instanceof PointerEvent) || dragPointerId !== event.pointerId) {
				return;
			}

			updateDrag(event.clientY);
		});

		surface?.addEventListener('pointerup', (event) => {
			if (event instanceof PointerEvent) {
				endDrag(event.pointerId);
			}
		});

		surface?.addEventListener('pointercancel', (event) => {
			if (event instanceof PointerEvent) {
				endDrag(event.pointerId);
			}
		});

		surface?.addEventListener('wheel', (event) => {
			if (!(event instanceof WheelEvent)) {
				return;
			}

			resumeAfterDrag = false;
			stopScrollPlayback();
			applyOffset(currentOffset - event.deltaY);
		}, { passive: true });

		updateMetronomeSoundButton();
		syncScreenWakeLock();
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') {
				syncScreenWakeLock();
				return;
			}

			void releaseScreenWakeLock();
		});

		setInitialPosition();
		window.addEventListener('resize', () => {
			const resumePlayback = isRunning;
			stopScrollPlayback();
			setInitialPosition();
			if (resumePlayback) {
				startScrollPlayback();
			}
		});
	</script>
</Layout>

